# ===========================================
# TIMECO - DESENVOLVIMENTO (Docker Emulators)
# ===========================================
# Banco local rodando em container Docker.
# Comando: docker compose up -d && npm run dev
# UI: http://localhost:4003
# ===========================================

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DB_MODE=emulator

EXPO_PUBLIC_FIREBASE_API_KEY=dev-api-key-timeco
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
EXPO_PUBLIC_FIREBASE_PROJECT_ID=timeco-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=timeco-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:dev

EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_EMULATOR_AUTH_PORT=9096
EXPO_PUBLIC_EMULATOR_FIRESTORE_PORT=8083
EXPO_PUBLIC_EMULATOR_STORAGE_PORT=9196
