{
  "expo": {
    "name": "Timeco",
    "slug": "timeco",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "timeco",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.timeco.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O Timeco precisa acessar suas fotos para você poder enviar fotos de perfil e da galeria de eventos.",
        "NSCameraUsageDescription": "O Timeco precisa acessar sua câmera para tirar fotos para o perfil e para a galeria de eventos.",
        "NSLocationWhenInUseUsageDescription": "O Timeco usa sua localização atual apenas quando você toca em \"Usar minha localização\" ao definir o local de um evento. Não rastreamos sua posição em background."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.timeco.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "com.googleusercontent.apps.1015687067416-su2vci2q471lvaqo86p199h07m5ieopo"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Timeco",
      "shortName": "Timeco",
      "themeColor": "#0F9D58",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Timeco precisa acessar suas fotos para você poder enviar fotos de perfil e da galeria de eventos.",
          "cameraPermission": "O Timeco precisa acessar sua câmera para tirar fotos para o perfil e para a galeria de eventos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F9D58",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Timeco usa sua localização atual apenas quando você toca em \"Usar minha localização\" ao definir o local de um evento. Não rastreamos sua posição em background."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "a022b433-8bfd-4ead-b74d-42d627ec2a3d"
      }
    },
    "owner": "incrivia"
  }
}
