# ===========================================
# TIMECO - PRODUCAO (Firebase real)
# ===========================================
# Projeto: timeco-prod (a ser criado via Firebase CLI)
# Preencher credenciais após `firebase projects:create timeco-prod`
# ===========================================

EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_DB_MODE=production

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=timeco-prod.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=timeco-prod
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=timeco-prod.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_USE_EMULATORS=false
