EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DB_MODE=emulator

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_EMULATOR_AUTH_PORT=9096
EXPO_PUBLIC_EMULATOR_FIRESTORE_PORT=8083
EXPO_PUBLIC_EMULATOR_STORAGE_PORT=9196

# Token público do Mapbox (opcional). Sem ele, busca de locais usa
# o Photon/OSM (dados limitados no Brasil). Com ele, qualidade similar
# ao Google Maps. Crie conta em https://mapbox.com (free tier 100k req/mês,
# não exige cartão) e cole aqui. No deploy Vercel, adicione como env var.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Google OAuth Client IDs (Google Cloud Console -> APIs & Services -> Credentials)
# - WEB: usado pelo Firebase signInWithPopup no web
# - ANDROID: usado pelo expo-auth-session no app Android (precisa SHA-1 do EAS)
# - IOS: idem para iOS (bundle id com.timeco.app)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
