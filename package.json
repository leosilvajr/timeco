{
  "name": "timeco",
  "version": "1.1.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "shx cp .env.production .env && expo start --web --port 8095",
    "dev:mobile": "shx cp .env.production .env && expo start",
    "dev:emulator": "shx cp .env.docker .env && expo start --web --port 8095",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f firebase",
    "docker:seed": "node scripts/seed-emulators.js",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "deploy:rules": "shx cp firestore.rules.production firestore.rules && firebase --project timeco-e908e deploy --only firestore:rules,firestore:indexes,storage && shx cp firestore.rules.dev firestore.rules",
    "deploy:functions": "firebase --project timeco-e908e deploy --only functions",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:web": "expo export --platform web",
    "eas:login": "eas login",
    "eas:build:preview": "eas build --platform android --profile preview",
    "eas:build:production": "eas build --platform android --profile production",
    "eas:submit": "eas submit --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/modals": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@tabler/icons-react": "^3.44.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "jest": "~29.7.0",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true
}
