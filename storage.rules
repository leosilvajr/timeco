rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatares: <user_id>/avatar.jpg sob avatars/
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Galeria de eventos: events/<event_id>/<file>
    match /events/{eventId}/{allPaths=**} {
      allow read: if request.auth != null;
      // Qualquer usuário autenticado pode subir; rules do Firestore
      // garantem que só participantes registram a foto na galeria
      allow create: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Compatibilidade legada — se algo usava esses paths antigos
    match /profile_photos/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /event_photos/{eventId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
