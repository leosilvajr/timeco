rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperadmin() {
      return isAuth() && role() == 'superadmin';
    }

    // ====== USERS ======
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperadmin();
      allow delete: if isSuperadmin();
    }

    // ====== FRIENDSHIPS ======
    // doc id = `${uidA}_${uidB}` (uids em ordem alfabética)
    match /friendships/{id} {
      // get: permite checagem de existência (resource == null) usada pelo
      // fluxo de "adicionar amigo" antes de criar; ou se o user é membro.
      allow get: if isAuth() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth() && (request.auth.uid in request.resource.data.members);
      allow update: if isAuth() && (request.auth.uid in resource.data.members);
      allow delete: if isAuth() && (request.auth.uid in resource.data.members);
    }

    // ====== FRIEND REQUESTS ======
    match /friendRequests/{id} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow delete: if isAuth() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }

    // ====== EVENTS (jogos) ======
    match /events/{eventId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.organizerId ||
        request.auth.uid in resource.data.invitedUserIds
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.organizerId;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.organizerId ||
        (request.auth.uid in resource.data.invitedUserIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmations', 'updatedAt']))
      );
      allow delete: if isAuth() && request.auth.uid == resource.data.organizerId;
    }

    // ====== PLAYER RATINGS (estrelas por evento) ======
    // doc id = `${eventId}_${playerUserId}`
    match /playerRatings/{id} {
      allow read: if isAuth();
      allow write: if isAuth() &&
        request.auth.uid == get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.organizerId;
    }

    // ====== NOTIFICATIONS ======
    match /notifications/{id} {
      allow read, write: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth();
    }

    // ====== AUDIT LOGS (super admin) ======
    match /auditLogs/{id} {
      allow read: if isSuperadmin();
      allow create: if isAuth();
    }

    // ====== VOLLEY MATCHES (modo avançado de scout) ======
    // Cada match pertence a um único usuário (ownerId). Por enquanto sem
    // compartilhamento — pessoa que cria é a única que lê/escreve.
    match /volleyMatches/{matchId} {
      allow read: if isAuth() && request.auth.uid == resource.data.ownerId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.ownerId;
      allow update: if isAuth()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuth() && request.auth.uid == resource.data.ownerId;
    }

    // ====== CHATS (1-a-1) ======
    // doc id = `${uidA}_${uidB}` (uids ordenados alfabeticamente)
    match /chats/{chatId} {
      function isChatMember() {
        return isAuth() && request.auth.uid in resource.data.members;
      }
      function isChatMemberOnCreate() {
        return isAuth() && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == 2;
      }
      // get permite resource == null para o cliente checar existência antes de
      // criar o chat (mesmo padrão de friendships).
      allow get: if isAuth() && (resource == null || isChatMember());
      allow list: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isChatMemberOnCreate();
      // update só pelos membros e sem alterar o array members.
      allow update: if isChatMember()
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      // ====== MESSAGES (subcollection) ======
      match /messages/{messageId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if isAuth() && request.auth.uid in chatMembers();
        allow create: if isAuth()
          && request.auth.uid in chatMembers()
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
